rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if request.auth != null;

      // Admin can update anything; owner can update own; any authenticated user can like
      allow update: if request.auth != null && (
        isAdmin()
        || request.auth.uid == resource.data.userId
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy'])
      );

      // Admin or owner can delete
      allow delete: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.userId
      );
    }

    match /clusters/{clusterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
