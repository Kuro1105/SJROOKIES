rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /complaints/{complaintId} {
      // Anyone can read complaints
      allow read: if true;

      // Any signed-in user can submit a complaint
      allow create: if request.auth != null;

      // Owner can update anything; others can only like (likeCount + likedBy) and only once
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy'])
          && !(request.auth.uid in resource.data.likedBy)
        )
      );

      // Only the owner can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /clusters/{clusterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
